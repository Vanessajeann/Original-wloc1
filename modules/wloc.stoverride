name: Apple WLOC 定位修改
desc: "修改 Apple 网络定位返回坐标 | Vanessajeann 维护版 | 安装和选点入口见项目主页"
author: Vanessajeann (based on samni728/wloc)
homepage: https://github.com/Vanessajeann/Original-wloc1
icon: https://raw.githubusercontent.com/Vanessajeann/Original-wloc1/refs/heads/main/wloc.jpg
category: Tools

http:
  mitm:
    - "gs-loc.apple.com"
    - "gs-loc-cn.apple.com"
  script:
    - match: ^https?:\/\/gs-loc(-cn)?\.apple\.com\/clls\/wloc
      name: WLOC.Location
      type: response
      require-body: true
      binary-mode: true
      max-size: 0
      timeout: 30
      argument: longitude=113.94114&latitude=22.544577&accuracy=25&logLevel=info
    - match: ^https?:\/\/gs-loc(-cn)?\.apple\.com\/wloc-settings\/save
      name: WLOC.Settings
      type: request
      require-body: false
      timeout: 10

script-providers:
  WLOC.Location:
    url: https://raw.githubusercontent.com/Vanessajeann/Original-wloc1/refs/heads/main/dist/wloc.js
    interval: 86400
  WLOC.Settings:
    url: https://raw.githubusercontent.com/Vanessajeann/Original-wloc1/refs/heads/main/dist/wloc-settings.js
    interval: 86400
